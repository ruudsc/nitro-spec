{
  "name": "@nitro-app/test-project",
  "private": true,
  "type": "module",
  "imports": {
    "#*": "./*"
  },
  "scripts": {
    "build": "pnpm --filter nitro-spec build && nitro build",
    "dev": "pnpm --filter nitro-spec build && nitro dev",
    "preview": "nitro preview",
    "lint": "oxlint --type-aware",
    "lint:fix": "oxlint --type-aware --fix --fix-suggestions",
    "format": "oxfmt --check",
    "format:fix": "oxfmt --write",
    "typecheck": "tsc --noEmit",
    "test": "pnpm --filter nitro-spec build && vitest run"
  },
  "dependencies": {
    "h3": "catalog:",
    "nitro-spec": "workspace:*"
  },
  "devDependencies": {
    "@asteasolutions/zod-to-openapi": "catalog:",
    "@types/node": "catalog:",
    "nitro": "3.0.260522-beta",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "typescript": "^6.0.3",
    "vitest": "catalog:",
    "zod": "catalog:"
  }
}
